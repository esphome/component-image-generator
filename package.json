{
  "name": "@esphome/component-image-generator",
  "version": "2.0.0",
  "description": "Generates SVG name badges for ESPHome components, used on the ESPHome website",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esphome/component-image-generator.git"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./astro": {
      "types": "./types/astro.d.ts",
      "default": "./src/astro.js"
    },
    "./ComponentBadge.astro": "./src/ComponentBadge.astro",
    "./package.json": "./package.json"
  },
  "bin": {
    "esphome-component-image": "./src/cli.js"
  },
  "files": [
    "src/*.js",
    "src/*.astro",
    "types/index.d.ts",
    "types/astro.d.ts",
    "ttf-montserrat/static/Montserrat-Black.ttf",
    "ttf-montserrat/OFL.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**' \"test/*.test.js\"",
    "component-image": "node src/cli.js",
    "embed-font": "node scripts/embed-font.mjs src/font-data.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22",
    "astro": "^7.3.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "esphome",
    "svg",
    "badge",
    "astro-component",
    "withastro"
  ],
  "peerDependencies": {
    "astro": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}
